# ── InsureSAAS backend environment ────────────────────────────────────────────
# Copy this file to ".env" and fill in the values, then: npm install && npm start

# Comma-separated list of allowed frontend origins (CORS).
FRONTEND_URL=http://localhost:3000,https://your-insuresaas-domain.com

# Port the backend listens on.
PORT=5000

# ── WhatsApp Business API (Meta) ───────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token

# ── Firebase Admin (REQUIRED — verifies the caller's ID token) ─────────────────
# The /send-whatsapp endpoint now requires a verified Firebase ID token. Provide
# a service account so the server can verify tokens. Use ONE of the two options:
#
#   Option A (recommended for a single env var): paste the service-account JSON
#   as a single line. In the Firebase Console:  Project Settings -> Service
#   accounts -> "Generate new private key", then paste the whole JSON here.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"insuresaas-4848b", ... }
#
#   Option B: point to the JSON file on disk (leave FIREBASE_SERVICE_ACCOUNT unset).
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
#
# NOTE: until one of these is set, /send-whatsapp returns 503 (secure by default).
